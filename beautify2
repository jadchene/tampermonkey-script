    const toRemoveArr=['#ev_talkbox_wrapper','aside','#relatedSearchesLGWContainer','#mfa_root','#b_footer','.b_ans','.b_msg','.pageRecoContainer','.css-knqde'];

    const toRemoveIntervalArr=['[data-za-detail-view-path-module=RightSideBar]','.Reward','.FollowButton','.LabelContainer-wrapper','.rh_reedm','.b_imagePair>.inner','.css-wcswpi','.scs_child_rpr','.b_ans'];

