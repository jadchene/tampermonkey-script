function listItemBeautify(selector){
  $(selector).hover(function(){
              $(this).css("box-shadow","1px 1px 10px #cccccc");
              $(this).css("border-radius","0");
           },function(){
             $(this).css("box-shadow","none");
         });
}

function cssWidth(selector,size){
  $(selector).css('width',size);
}

function cssWidth100(selector){
  cssWidth(selector,'100%');
}