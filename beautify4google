(function () {
  'use strict';

  GM_addStyle(`
    /* 隐藏广告/侧边栏/底部等 */
    #taw,
    .crJ18e,
    .cUnQKe,
    .jmjoTe,
    .zp6Lyf,
    .LnCrMe,
    .M8OgIe,
    #bottomads,
    .ITCGwe,
    .gY2b2c,
    .XqFnDf,
    .xQjRM,
    .JNkvid,
    #rhs,
    .ULSxyf,
    #sfooter,
    #tvcap,
    #tadsb,
    [jsname="tovEib"],
    #Sva75c {
      display: none !important;
    }

    /* 主内容宽度 */
    #center_col,
    #rso > div > div > div > div,
    .srKDX {
      width: 1000px !important;
    }

    /* 布局居中 */
    .GyAeWb {
      justify-content: center !important;
      max-width: 5000px !important;
    }

    .Q3DXx.yIbDgf {
      justify-content: center !important;
    }

    /* 偏移调整 */
    .s6JM6d {
      margin-left: 240px !important;
    }

    .GG4mbd {
      margin-left: 25% !important;
    }

    .NDnoQ {
      margin-left: 15% !important;
    }

    /* 搜索结果 hover 美化 */
    .MjjYud:hover {
      box-shadow: 1px 1px 10px #cccccc !important;
      border-radius: 0 !important;
    }

    .MjjYud:not(:hover) {
      box-shadow: none !important;
    }
  `);
})();
