// ==UserScript==
// @name         beautify4google
// @namespace    http://tampermonkey.net/chenjd
// @version      0.2
// @description  simplify google style
// @author       You
// @match        *://*.google.com/*
// @match        *://*.google.com.hk/*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=google.com
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  GM_addStyle(`
    /* 隐藏广告/侧边栏/底部等 */
    #taw,
    .crJ18e,
    .cUnQKe,
    .jmjoTe,
    .zp6Lyf,
    .LnCrMe,
    .M8OgIe,
    #bottomads,
    .ITCGwe,
    .gY2b2c,
    .XqFnDf,
    .xQjRM,
    .JNkvid,
    #rhs,
    .ULSxyf,
    #sfooter,
    #tvcap,
    #tadsb,
    [jsname="tovEib"],
    table.SwU7oc.wHYlTd,
    #Sva75c,
    #oFNiHe,
    .vbIt3d{
      display: none !important;
    }

    /* 主内容宽度 */
    #center_col,
    #rso > div > div > div > div,
    .srKDX {
      width: 1000px !important;
    }

    /* 布局居中 */
    .GyAeWb {
      justify-content: center !important;
      max-width: 5000px !important;
    }

    .Q3DXx.yIbDgf {
      justify-content: center !important;
    }

    /* 偏移调整 */
    .s6JM6d {
      margin-left: 240px !important;
    }

    .GG4mbd {
      margin-left: 25% !important;
    }

    /* 搜索框居中，左右留出按钮空间 */
    @media (min-width: 900px) {
      #searchform {
        display: block !important;
      }

      #searchform > .NDnoQ {
        position: relative !important;
        box-sizing: border-box !important;
        width: 100% !important;
        margin: 0 !important;
        padding: 0 200px !important;
      }

      #searchform #tsf {
        width: 100% !important;
        max-width: 861px !important;
        min-width: 0 !important;
        margin: 0 auto !important;
      }

      /* 取消搜索框原有的负边距 */
      #searchform .A8SBwf {
        margin: 0 !important;
      }

      /* 右侧分享、应用和头像完整显示 */
      #searchform .Q3DXx {
        position: absolute !important;
        right: 16px !important;
        top: 0 !important;
        flex-shrink: 0 !important;
      }
    }

    /* 搜索结果 hover 美化 */
    .MjjYud:hover {
      box-shadow: 1px 1px 10px #cccccc !important;
      border-radius: 0 !important;
    }

    .MjjYud:not(:hover) {
      box-shadow: none !important;
    }
  `);
})();
