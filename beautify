(function() {
    'use strict';

    const toRemoveArr=['aside[aria-label="更多结果"]','#b_pole','.rc_gb_seemore','.inner','#mfa_root','.b_gobig_feedback','#lMapContainer','.scs_child_rpr','.b_vList','.b_algoArticleTextCarousel',
                     '.b_richcard','.b_rs','.b_msg','.b_ans','#b_footer','.b_rc_gb_bottom_cover','.b_slidesContainer','.SearchSideBar','aside[aria-label="Additional Results"]','.ContentItem-more',
                     '.GlobalSideBar','.Question-sideColumn','#b_opalpers','.EduSectionItem-video','.FollowButton'
                    ];

    const toRemoveIntervalArr=['.TopstoryItem--advertCard','.RichContent-cover','.Question-sideColumn','.scs_child_rpr','.Pc-Business-Card-PcTopFeedBanner','.ContentItem-more','.EduSectionItem-video','#b_opalpers','.FollowButton'];

    const toRemoveArrStr=toRemoveArr.join();

    const toRemoveIntervalArrStr=toRemoveIntervalArr.join();

    const toWidth100Arr=['.SearchMain','.Topstory-mainColumn','.Question-mainColumn','.QuestionWaiting-mainColumn','.ListShortcut'];

    cssWidth('#b_results','60%');
    $('#b_results').css('margin-left','15%');
    $('#b_header').css('padding-left','25%');
    $('#b_tween').css('padding-left','28%');

    for(let selector of toWidth100Arr){
      cssWidth100(selector);
    }

    $('.b_algo').removeClass('b_rc_gb_template');
    $('.b_algo').removeClass('b_algoBorder');

    listItemBeautify('.b_algo');

    $(toRemoveArrStr).remove();

    removeZhihuVideoCard();

    const toRemoveZhihuTop=$('.Topstory').children().eq(0);
    if(!toRemoveZhihuTop.hasClass('Topstory-container')){
      toRemoveZhihuTop.remove();
    }

    setInterval(
      function(){
          $(toRemoveIntervalArrStr).remove();
          $('.ArticleItem').parent().parent().parent().remove();
          cssWidth100('.Question-mainColumn');
          listItemBeautify('.TopstoryItem');
          removeZhihuVideoCard();
          $('.RichContent-inner img').css('max-width','480px');
      },1000
    );

})();

function listItemBeautify(selector){
  $(selector).hover(function(){
              $(this).css("box-shadow","1px 1px 10px #cccccc");
              $(this).css("border-radius","0");
           },function(){
             $(this).css("box-shadow","none");
         });
}

function cssWidth(selector,size){
  $(selector).css('width',size);
}

function cssWidth100(selector){
  cssWidth(selector,'100%');
}

function removeZhihuVideoCard(){
    const toRemoveVideoCard=$('.VideoAnswerPlayer,.ZVideoItem-video').parent().parent().parent().parent();
    if(toRemoveVideoCard.hasClass('AnswerCard')){
      toRemoveVideoCard.hide();
    }
    $('.css-n608gg').parent().parent().parent().hide();
    $('.ZVideoItem').parent().parent().parent().remove();
    $('.ZVideoItem-video').next().remove();
    $('.ZVideoItem-video').remove();
    $('.VideoAnswerPlayer').next().remove();
    $('.VideoAnswerPlayer').remove();
    $('.LabelContainer').parent().parent().remove();
}