(function () {
  'use strict';

  GM_addStyle(`
    /* 页面主区域宽度 */
    .Topstory-mainColumn,
    .QuestionWaiting-mainColumn,
    .ListShortcut,
    .SearchMain,
    .Profile-mainColumn,
    .Question-mainColumn {
      width: 100% !important;
    }

    .Post-Row-Content-left{
      width: 1000px !important;
    }

    /* 隐藏侧栏、广告、推荐、视频等 */
    .css-1qyytj7,
    .is-collapsed > .RichContent-cover,
    .Question-sideColumn,
    .QuestionButtonGroup>.FollowButton,
    .LabelContainer-wrapper,
    .RichText-ADLinkCardContainer,
    .Reward,
    .Pc-word,
    .Pc-word-new,
    .VideoAnswerPlayer,
    .TopstoryItem--advertCard,
    .ZVideoItem,
    .WriteArea,
    #SearchMain + *,
    .is-shown,
    .Pc-Business-Card-PcTopFeedBanner,
    .SearchResult-Card:has(.RelevantQuery),
    .pc-article-answer-text-chain,
    .pc-article-answer,
    .List-item:has(.VideoAnswerPlayer) {
      display: none !important;
    }
  `);
})();
